# Sync2NAS Environment Configuration Template
# Copy this file to .env and update the values for your environment
# All variables are optional - the application will use defaults from config files if not set

# =============================================================================
# LLM Service Configuration
# =============================================================================

# Primary LLM service to use (ollama, openai, anthropic)
# Default: ollama
SYNC2NAS_LLM_SERVICE=ollama

# LangChain Caching Configuration
# Enable caching of LLM responses for better performance
# Default: false
SYNC2NAS_LLM_ENABLE_CACHE=true

# Path for LLM response cache (SQLite database)
# Default: .langchain_cache.db
SYNC2NAS_LLM_CACHE_PATH=.langchain_cache.db

# LangSmith Tracing Configuration (Optional)
# Enable tracing for debugging and monitoring LLM chains
# Default: false
SYNC2NAS_LLM_ENABLE_TRACING=false

# LangSmith API key (required if tracing is enabled)
# Get from: https://smith.langchain.com/
SYNC2NAS_LLM_LANGSMITH_API_KEY=your_langsmith_api_key_here

# LangSmith project name for organizing traces
# Default: sync2nas
SYNC2NAS_LLM_LANGSMITH_PROJECT=sync2nas

# =============================================================================
# OpenAI Configuration (if using OpenAI as LLM service)
# =============================================================================

# OpenAI API key (required for OpenAI service)
# Get from: https://platform.openai.com/api-keys
SYNC2NAS_OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use
# Default: gpt-3.5-turbo
SYNC2NAS_OPENAI_MODEL=gpt-3.5-turbo

# Maximum tokens for OpenAI responses
# Default: 150
SYNC2NAS_OPENAI_MAX_TOKENS=150

# Temperature for OpenAI responses (0.0-2.0)
# Default: 0.1
SYNC2NAS_OPENAI_TEMPERATURE=0.1

# =============================================================================
# Anthropic Configuration (if using Anthropic as LLM service)
# =============================================================================

# Anthropic API key (required for Anthropic service)
# Get from: https://console.anthropic.com/
SYNC2NAS_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic model to use
# Default: claude-3-haiku-20240307
SYNC2NAS_ANTHROPIC_MODEL=claude-3-haiku-20240307

# Maximum tokens for Anthropic responses
# Default: 150
SYNC2NAS_ANTHROPIC_MAX_TOKENS=150

# Temperature for Anthropic responses (0.0-1.0)
# Default: 0.1
SYNC2NAS_ANTHROPIC_TEMPERATURE=0.1

# =============================================================================
# Ollama Configuration (if using Ollama as LLM service)
# =============================================================================

# Ollama server host URL
# Default: http://localhost:11434
SYNC2NAS_OLLAMA_HOST=http://localhost:11434

# Ollama model to use
# Recommended: JSON-optimized models for structured output
# - ministral-3:14b (default, excellent JSON output - recommended)
# - ministral-3:8b (lighter weight, excellent JSON output)
# - qwen2.5:7b (good JSON output, fast)
# - llama3.2:3b (compact, decent JSON output)
# Default: ministral-3:14b
SYNC2NAS_OLLAMA_MODEL=ministral-3:14b

# Context window size for Ollama
# Default: 4096
SYNC2NAS_OLLAMA_NUM_CTX=4096

# =============================================================================
# Usage Notes
# =============================================================================

# 1. LLM Service Selection:
#    - ollama: Local inference, no API key required, good for privacy
#    - openai: Cloud-based, requires API key, high quality results
#    - anthropic: Cloud-based, requires API key, good for complex reasoning

# 2. Performance Tuning:
#    - Enable caching for better performance with repeated queries
#    - Adjust max_tokens based on your needs (lower = faster, higher = more detailed)
#    - Lower temperature = more consistent results, higher = more creative

# 3. Debugging:
#    - Enable LangSmith tracing to debug chain execution
#    - Check logs for detailed error messages
#    - Use dry-run mode to test without making changes

# 4. Security:
#    - Never commit .env files with real API keys to version control
#    - Use environment-specific .env files for different deployments
#    - Rotate API keys regularly for security